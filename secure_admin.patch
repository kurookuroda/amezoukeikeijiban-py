+sub verify_admin_password {
+    my ($input) = @_;
+    return 0 unless defined $input && length($input);
+
+    my $stored = &load_delcrypt;
+    return 0 if $stored eq '';
+
+    # Argon2id 形式のみ許可（古い crypt 形式は拒否）
+    return 0 unless $stored =~ /^\$argon2id\$/;
+
+    return argon2id_verify($stored, $input) ? 1 : 0;
+}
+
+# 初回設定・パスワード変更用（コマンドラインなどから一度だけ実行）
+sub generate_admin_hash {
+    my ($password) = @_;
+    return '' unless defined $password && length($password) >= 8;
+
+    my $salt = urandom($ARGON2_SALT_LEN);
+    my $hash = argon2id_pass(
+        $password,
+        $salt,
+        $ARGON2_TIME,
+        $ARGON2_MEMORY,
+        $ARGON2_PARALLELISM
+    );
+    return $hash;
+}
